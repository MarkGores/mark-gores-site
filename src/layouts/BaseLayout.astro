---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Mark Gores | Realtor in Prior Lake, Minnesota",
  description = "Mark Gores — Prior Lake realtor with 22 years of experience and a 5.0 Zillow rating. Honest real estate advice in Prior Lake, Savage, Shakopee, and the south metro. No pitch, no pressure."
} = Astro.props;

const siteUrl = "https://markgores.com";
const ogImage = `${siteUrl}/og-image.jpg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href={siteUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;1,6..72,300;1,6..72,400&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={siteUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Geo Tags (local SEO) -->
    <meta name="geo.region" content="US-MN" />
    <meta name="geo.placename" content="Prior Lake" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "RealEstateAgent",
        "name": "Mark Gores",
        "description": "Prior Lake realtor with 22 years of experience. Honest real estate advice for buyers and sellers in the south metro.",
        "url": "https://markgores.com",
        "telephone": "+1-612-201-5447",
        "email": "mark@markgores.com",
        "image": "https://markgores.com/images/family.jpg",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Prior Lake",
          "addressRegion": "MN",
          "postalCode": "55372",
          "addressCountry": "US"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 44.7133,
          "longitude": -93.4227
        },
        "areaServed": [
          { "@type": "City", "name": "Prior Lake", "sameAs": "https://en.wikipedia.org/wiki/Prior_Lake,_Minnesota" },
          { "@type": "City", "name": "Savage" },
          { "@type": "City", "name": "Shakopee" },
          { "@type": "City", "name": "Lakeville" },
          { "@type": "City", "name": "Burnsville" },
          { "@type": "City", "name": "Apple Valley" },
          { "@type": "City", "name": "Eagan" }
        ],
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "5.0",
          "bestRating": "5",
          "ratingCount": "12",
          "reviewCount": "12"
        },
        "worksFor": {
          "@type": "RealEstateAgent",
          "name": "RE/MAX Advantage Plus"
        },
        "knowsAbout": ["residential real estate", "home buying", "home selling", "Prior Lake real estate", "south metro Minnesota"],
        "sameAs": [
          "https://priorlakeevents.com",
          "https://www.zillow.com/profile/MarkGoresREMAX"
        ]
      }
    </script>

    <meta name="generator" content={Astro.generator} />

    <!-- Google Search Console: uncomment and replace XXXX with your verification code -->
    <!-- <meta name="google-site-verification" content="XXXX" /> -->

    <!-- Google Analytics (GA4) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-7S3PH1TDW4"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-7S3PH1TDW4');
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
