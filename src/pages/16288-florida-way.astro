        </div>
        <div class="closing-method">
          <span class="label">Email</span>
          <a href="mailto:mark@markgores.com">mark@markgores.com</a>
        </div>
      </div>

      <p class="closing-sign">Mark</p>
    </div>
  </section>

</main>

