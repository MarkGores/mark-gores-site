<script is:inline>
  // Cost estimator
  var live = document.getElementById('calc-live');
  var stat = document.getElementById('calc-static');
  var priceInput = document.getElementById('calc-price');
  var slider = document.getElementById('calc-slider');
  var outListing = document.getElementById('calc-listing');
  var outBuyer = document.getElementById('calc-buyer');
  var outDeed = document.getElementById('calc-deed');
  var outTotal = document.getElementById('calc-total');
  var outClear = document.getElementById('calc-clear');
  if (live && stat && priceInput && slider && outListing && outBuyer && outDeed && outTotal && outClear) {
    var LISTING = 0.027, BUYER = 0.027, DEED = 0.0033, FLAT = 1225; // settlement 595 + conservation 5 + transaction 625
    var fmt = function (n) { return '$' + Math.round(n).toLocaleString('en-US'); };
    var clampP = function (n) { return Math.min(2000000, Math.max(50000, n)); };
    var render = function (price) {
      var total = price * (LISTING + BUYER + DEED) + FLAT;
      outListing.textContent = fmt(price * LISTING);
      outBuyer.textContent = fmt(price * BUYER);
      outDeed.textContent = fmt(price * DEED);
      outTotal.textContent = fmt(total);
      outClear.textContent = fmt(price - Math.round(total));
      priceInput.value = fmt(price);
      slider.value = String(Math.min(500000, Math.max(250000, price)));
    };
    priceInput.addEventListener('change', function () {
      var digits = priceInput.value.replace(/[^0-9]/g, '');
      render(clampP(Number(digits || '399000')));
    });
    priceInput.addEventListener('focus', function () { priceInput.select(); });
    slider.addEventListener('input', function () { render(Number(slider.value)); });
    live.hidden = false;
    stat.classList.add('screen-hidden');
    render(399000);
  }
</script>

</BaseLayout>

