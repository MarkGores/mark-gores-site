            <th class="r">Date</th>
            <th class="r">SqFt</th>
            <th class="r">Lot</th>
            <th class="r">Yr</th>
            <th class="r">$/SF</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>16338 Fishing Avenue<br><span class="sub">Nearest twin · 4 bed</span></td>
            <td class="r">$399,990</td>
            <td class="r">6/12/26</td>
            <td class="r">1,910</td>
            <td class="r">0.35</td>
            <td class="r">1976</td>
            <td class="r">$209</td>
          </tr>
          <tr>
            <td>6965 Upper 164th Street<br><span class="sub">Same 1970 build · sold at once</span></td>
            <td class="r">$395,000</td>
            <td class="r">2/27/26</td>
            <td class="r">1,962</td>
            <td class="r">0.27</td>
            <td class="r">1970</td>
            <td class="r">$201</td>
          </tr>
          <tr>
            <td>16883 Galena Avenue<br><span class="sub">Listed $360k, bid up in 6 days</span></td>
            <td class="r">$380,000</td>
            <td class="r">7/01/26</td>
            <td class="r">1,923</td>
            <td class="r">0.51</td>
            <td class="r">1971</td>
            <td class="r">$198</td>
          </tr>
          <tr>
            <td>16469 Glengary Court<br><span class="sub">5 bed · sold in 2 days</span></td>
            <td class="r">$397,000</td>
            <td class="r">8/12/25</td>
            <td class="r">2,050</td>
            <td class="r">0.28</td>
            <td class="r">1968</td>
            <td class="r">$194</td>
          </tr>
          <tr>
            <td>16546 Foliage Avenue<br><span class="sub">5 bed · similar size</span></td>
            <td class="r">$388,900</td>
            <td class="r">12/05/25</td>
            <td class="r">1,991</td>
            <td class="r">0.27</td>
            <td class="r">1971</td>
            <td class="r">$195</td>
          </tr>
          <tr>
            <td>16473 Flagstaff Way<br><span class="sub">Same size · 4 bed</span></td>
            <td class="r">$375,000</td>
            <td class="r">7/11/25</td>
            <td class="r">1,918</td>
            <td class="r">0.25</td>
            <td class="r">1972</td>
            <td class="r">$196</td>
          </tr>
          <tr class="summary">
            <td><strong>Median / Average</strong></td>
            <td class="r"><strong>$392k / $389k</strong></td>
            <td class="r">avg</td>
            <td class="r">1,959</td>
            <td class="r">0.32</td>
            <td class="r">1971</td>
            <td class="r"><strong>$199</strong></td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="callout">
      <div class="callout-label">Adjusted to your home</div>
      <p>
        16338 Fishing and 6965 Upper 164th are the closest matches: four bedrooms, about 1,900 square feet, same era, sold this year at <strong>$399,990</strong> and <strong>$395,000</strong>. <strong>$399,000</strong> is right in line with them.
      </p>
    </div>
  </section>

  <!-- THE NEIGHBORHOOD (dark) -->
