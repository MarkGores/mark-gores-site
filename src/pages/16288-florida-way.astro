---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "16288 Florida Way | A Market Analysis from Mark Gores";
const description = "A market-based pricing analysis and marketing plan prepared by Mark Gores for Tyler Hopkins at 16288 Florida Way, Rosemount.";

// Estimator default (list price)
const LIST = 399000;
---

<BaseLayout title={title} description={description} noindex={true}>

<script is:inline>document.documentElement.classList.add('js');</script>

<nav class="proposal-nav">
  <a href="/" class="name">Mark Gores</a>
  <div class="nav-meta">Prepared for Tyler Hopkins · July 2026</div>
</nav>

<main class="proposal">

  <!-- HERO -->
  <section class="prop-hero">
    <div class="prop-hero-content">
      <div class="prop-label">A Market Analysis</div>
      <h1>For Tyler Hopkins<br><em>16288 Florida Way, Rosemount</em></h1>
      <p class="prop-hero-text">
        Tyler, here's the homework behind the $399,000: what's selling in Donnay's Valley Park, the comps, the marketing plan, and what you'll net at closing.
      </p>
      <div class="prop-signature">Mark</div>
    </div>

    <aside class="prop-facts">
      <div class="prop-facts-label">The property at a glance</div>
      <div class="facts-rows">
        <div class="facts-row"><span class="facts-v">1970</span><span class="facts-l">Year built</span></div>
        <div class="facts-row"><span class="facts-v">4 / 2</span><span class="facts-l">Beds / baths</span></div>
        <div class="facts-row"><span class="facts-v">1,900</span><span class="facts-l">Finished sq ft</span></div>
        <div class="facts-row"><span class="facts-v">0.33 ac</span><span class="facts-l">Lot</span></div>
      </div>
      <p class="prop-facts-foot">
        Four bedrooms, two baths, two-car garage, on a third of an acre in Donnay's Valley Park. Updated kitchen and baths, new electrical panel, diseased trees removed.
      </p>
    </aside>
  </section>

  <!-- THE NUMBER -->
  <section class="recommendation">
    <div class="section-label-alt">The Number</div>
    <h2>List at <em>$399,000</em></h2>
    <p class="rec-sub">
      Where it should land: <strong>right in with the two closest sales, $395,000 and $400,000</strong><br>
      Most likely buyer: <strong>a family after a move-in-ready four-bedroom in Rosemount</strong>
    </p>

    <div class="rec-why">
      <p>
        The two closest sales: 16338 Fishing, a 1,910 square foot four-bedroom, sold for $399,990 in June. 6965 Upper 164th, same 1970 build at 1,962 square feet, sold for $395,000 in February. Homes like yours have gone from about $190 a square foot in 2024 to $203 in 2026. The neighborhood had 36 sales in the last year, averaging 14 days on market at 102.6% of list. $399,000 sits right on those numbers.
      </p>
    </div>

    <div class="rec-range">
      <div class="range-card">
        <div class="range-label">Safe</div>
        <div class="range-price">$385,000</div>
        <div class="range-note">Under the comps. Reaches the most buyers, probably leaves money behind.</div>
      </div>
      <div class="range-card recommended">
        <div class="range-label">Recommended</div>
        <div class="range-price">$399,000</div>
        <div class="range-note">Right where the two closest sales landed this year.</div>
      </div>
      <div class="range-card">
        <div class="range-label">Stretch</div>
        <div class="range-price">$412,000</div>
        <div class="range-note">Above what the neighborhood has sold for lately. Would take the right buyer and more time.</div>
      </div>
    </div>

  </section>

  <!-- THE HOME -->
  <section class="specs">
    <div class="section-label-alt">The Home</div>
    <h2>What's here.</h2>
    <div class="specs-grid">
      <div class="spec"><div class="spec-v">1970</div><div class="spec-l">Year Built</div></div>
      <div class="spec"><div class="spec-v">4</div><div class="spec-l">Bedrooms</div></div>
      <div class="spec"><div class="spec-v">2</div><div class="spec-l">Bathrooms</div></div>
      <div class="spec"><div class="spec-v">1,900</div><div class="spec-l">Finished Sq Ft</div></div>
      <div class="spec"><div class="spec-v">950</div><div class="spec-l">Above Grade</div></div>
      <div class="spec"><div class="spec-v">950</div><div class="spec-l">Lower Level</div></div>
      <div class="spec"><div class="spec-v">0.33 ac</div><div class="spec-l">Lot</div></div>
      <div class="spec"><div class="spec-v">2-car</div><div class="spec-l">Garage</div></div>
    </div>
    <p class="specs-narrative">
      Four bedrooms and two baths across two levels, 1,900 finished square feet split evenly up and down, on a third of an acre with a two-car garage. The kitchen and baths are updated. The electrical panel was replaced and the large diseased trees have been removed. It's move-in ready.
    </p>
  </section>

  <!-- THE COMPS -->
