<script is:inline define:vars={{ CURVE, N24 }}>
  // Reading progress hairline
  var fill = document.getElementById('progress-fill');
  if (fill) {
    var updateFill = function () {
      var doc = document.documentElement;
      var max = doc.scrollHeight - window.innerHeight;
      fill.style.width = max > 0 ? (window.scrollY / max) * 100 + '%' : '0%';
    };
    window.addEventListener('scroll', updateFill, { passive: true });
    updateFill();
  }

  // Reveal on scroll
  var reveal = document.querySelectorAll('[data-rv]');
  if ('IntersectionObserver' in window && reveal.length) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px' });
    reveal.forEach(function (el) { io.observe(el); });
  } else {
    reveal.forEach(function (el) { el.classList.add('in'); });
  }

  // Evidence chart: price-band filter
  var PLOT_BOTTOM = 260, PLOT_LEFT = 60, PLOT_RIGHT = 700;
  var BAND = (PLOT_RIGHT - PLOT_LEFT) / 6, BAR_W = 60;
  var yOf = function (v) { return PLOT_BOTTOM - v * 2.2; };
  var barX = function (i) { return PLOT_LEFT + i * BAND + (BAND - BAR_W) / 2; };
  var barPath = function (i, v) {
    var x = barX(i), y = yOf(v), r = 3, w = BAR_W;
    return 'M ' + x + ' ' + PLOT_BOTTOM + ' V ' + (y + r) + ' Q ' + x + ' ' + y + ' ' + (x + r) + ' ' + y +
           ' H ' + (x + w - r) + ' Q ' + (x + w) + ' ' + y + ' ' + (x + w) + ' ' + (y + r) + ' V ' + PLOT_BOTTOM + ' Z';
  };
  var fmtN = function (n) { return n.toLocaleString('en-US'); };
  var chips = document.querySelectorAll('.curve-filters .chip');
  var curveN = document.getElementById('curve-n');
  chips.forEach(function (chip) {
    chip.addEventListener('click', function () {
      var band = chip.getAttribute('data-band');
      var data = CURVE[band];
      if (!data) return;
      chips.forEach(function (c) {
        var on = c === chip;
        c.classList.toggle('is-on', on);
        c.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      var total = 0;
      data.forEach(function (b, i) {
        total += b.n;
        var bar = document.getElementById('bar-' + i);
        var val = document.getElementById('bval-' + i);
        var n = document.getElementById('bn-' + i);
        if (bar) {
          bar.setAttribute('d', barPath(i, b.pct));
          var t = bar.parentNode.querySelector('title');
          if (t) t.textContent = b.bucket + ' days: ' + b.pct + '% sold at or over ask · median ' + b.medRatio + '% of ask · ' + fmtN(b.n) + ' sales';
        }
        if (val) { val.setAttribute('y', yOf(b.pct) - 10); val.textContent = b.pct + '%'; }
        if (n) n.textContent = fmtN(b.n) + ' sales';
      });
      if (curveN) curveN.textContent = band === 'all' ? 'Showing all ' + fmtN(N24) + ' sales.' : 'Showing ' + fmtN(total) + ' sales in this price band.';
    });
  });

  // Fee calculator
  var live = document.getElementById('calc-live');
  var stat = document.getElementById('calc-static');
  var priceInput = document.getElementById('calc-price');
  var slider = document.getElementById('calc-slider');
  var outListing = document.getElementById('calc-listing');
  var outBuyer = document.getElementById('calc-buyer');
  var outDeed = document.getElementById('calc-deed');
  var outTitle = document.getElementById('calc-title');
  var outTotal = document.getElementById('calc-total');
  var outClear = document.getElementById('calc-clear');
  var outDelta = document.getElementById('calc-delta');
  if (live && stat && priceInput && slider && outListing && outBuyer && outDeed && outTitle && outTotal && outClear && outDelta) {
    var LISTING = 0.027, BUYER = 0.027, DEED = 0.0033, TITLE = 1250;
    var fmt = function (n) { return '$' + Math.round(n).toLocaleString('en-US'); };
    var clampP = function (n) { return Math.min(5000000, Math.max(100000, n)); };
    var render = function (price) {
      var total = price * (LISTING + BUYER + DEED) + TITLE;
      outListing.textContent = fmt(price * LISTING);
      outBuyer.textContent = fmt(price * BUYER);
      outDeed.textContent = fmt(price * DEED);
      outTitle.textContent = fmt(TITLE);
      outTotal.textContent = fmt(total);
      outClear.textContent = fmt(price - total);
      outDelta.textContent = fmt(price * 0.003);
      priceInput.value = fmt(price);
      slider.value = String(Math.min(1500000, Math.max(200000, price)));
    };
    priceInput.addEventListener('change', function () {
      var digits = priceInput.value.replace(/[^0-9]/g, '');
      render(clampP(Number(digits || '500000')));
    });
    priceInput.addEventListener('focus', function () { priceInput.select(); });
    slider.addEventListener('input', function () { render(Number(slider.value)); });
    live.hidden = false;
    stat.classList.add('screen-hidden');
    render(500000);
  }
</script>

