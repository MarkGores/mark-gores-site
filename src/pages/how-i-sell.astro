---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "A Marketing Plan | Mark Gores";
const description = "The plan Mark Gores runs for every listing: pricing built on live south metro market evidence, launch mechanics, weekly written reporting, and a published 2.7% fee. In writing, so you can check it.";

/*
 * Market evidence baked from NorthstarMLS via the local listings.db
 * (PriorLake.RealEstate sync). To refresh: run scripts/refresh-market-data.py
 * against the DB and paste the new values + update AS_OF.
 * Filters: 7 south metro cities, PropertyType Residential, single family
 * (both PropertySubType conventions), new construction excluded,
 * ClosePrice/ListPrice sanity 0.5..1.5.
 */
const AS_OF = "July 8, 2026";
const N24 = 4971;   // closed, last 24 months
const N12 = 2499;   // closed, last 12 months
const TOPLINE = { sold12: "2,499", medClose: "$474,900", medDom: "15", actives: "738", newCon: "350" };

const PULSE = [
  { city: "Prior Lake",   n: 315, medClose: 587250, medDom: 19, ppsf: 216,
    series: [625000,605000,495000,546700,750000,495000,765000,460000,510000,515000,582500,610888,606000,612500,576125,560000,569211,520000,820000,570000,596500,622000,596500,565000] },
  { city: "Savage",       n: 221, medClose: 464900, medDom: 17, ppsf: 192,
    series: [520000,490100,482450,515000,490000,439900,489500,419500,478500,470674,475000,532500,528500,432500,490250,460000,474900,450000,426500,433000,431000,454000,540000,463000] },
  { city: "Shakopee",     n: 301, medClose: 454900, medDom: 15, ppsf: 192,
    series: [470000,485000,430000,387500,424950,392895,515500,435000,418000,425000,480000,475000,448250,426000,461950,480000,520000,455000,375000,410000,455000,458000,454900,475000] },
  { city: "Lakeville",    n: 558, medClose: 549900, medDom: 18, ppsf: 195,
    series: [527500,550950,572000,563500,466000,546500,482500,490000,505000,565000,563000,567000,550000,572500,528000,551862,557000,525500,512500,500000,499625,577500,595500,537895] },
  { city: "Burnsville",   n: 387, medClose: 425000, medDom: 13, ppsf: 180,
    series: [417500,410000,400000,413300,425000,399900,430000,435000,430000,430000,420000,423900,416000,410000,470000,423000,410900,402500,377440,410000,400000,442000,470000,454950] },
  { city: "Apple Valley", n: 310, medClose: 436500, medDom: 14, ppsf: 196,
    series: [410500,425000,407000,429000,412950,420000,451000,419950,412500,445500,447350,449950,450000,457000,442500,390000,435000,449900,442500,480000,420000,421700,434000,460000] },
  { city: "Eagan",        n: 407, medClose: 457400, medDom: 12, ppsf: 204,
    series: [500000,605000,425000,449000,455000,462500,453500,420000,510000,517000,479000,457050,515000,458750,435000,452500,447000,467500,450000,485000,449500,432000,494000,489000] },
];

// Share of sales at or over final asking price, by days on market.
const CURVE = {
  all: [
    { bucket: "0-7",   n: 1402, medRatio: 101.5, pct: 87 },
    { bucket: "8-14",  n: 1101, medRatio: 100.0, pct: 76 },
    { bucket: "15-30", n: 1046, medRatio: 100.0, pct: 53 },
    { bucket: "31-60", n: 863,  medRatio: 98.8,  pct: 40 },
    { bucket: "61-90", n: 288,  medRatio: 98.9,  pct: 38 },
    { bucket: "91+",   n: 261,  medRatio: 97.8,  pct: 26 },
  ],
  under400: [
    { bucket: "0-7",   n: 338, medRatio: 101.4, pct: 84 },
    { bucket: "8-14",  n: 258, medRatio: 100.5, pct: 79 },
    { bucket: "15-30", n: 240, medRatio: 100.0, pct: 50 },
    { bucket: "31-60", n: 198, medRatio: 98.7,  pct: 40 },
    { bucket: "61-90", n: 60,  medRatio: 98.2,  pct: 32 },
    { bucket: "91+",   n: 45,  medRatio: 98.7,  pct: 29 },
  ],
  b400600: [
    { bucket: "0-7",   n: 735, medRatio: 102.2, pct: 90 },
    { bucket: "8-14",  n: 612, medRatio: 100.0, pct: 77 },
    { bucket: "15-30", n: 578, medRatio: 100.0, pct: 57 },
    { bucket: "31-60", n: 430, medRatio: 99.1,  pct: 45 },
    { bucket: "61-90", n: 145, medRatio: 99.1,  pct: 43 },
    { bucket: "91+",   n: 110, medRatio: 98.4,  pct: 31 },
  ],
  over600: [
    { bucket: "0-7",   n: 329, medRatio: 100.3, pct: 84 },
    { bucket: "8-14",  n: 231, medRatio: 100.0, pct: 68 },
    { bucket: "15-30", n: 228, medRatio: 99.6,  pct: 47 },
    { bucket: "31-60", n: 235, medRatio: 98.3,  pct: 30 },
    { bucket: "61-90", n: 83,  medRatio: 98.6,  pct: 35 },
    { bucket: "91+",   n: 106, medRatio: 96.9,  pct: 21 },
  ],
};

// Chart geometry (must match the inline client script)
const CW = 720, CH = 320, PLOT_BOTTOM = 260, PLOT_LEFT = 60, PLOT_RIGHT = 700;
const BAND = (PLOT_RIGHT - PLOT_LEFT) / 6, BAR_W = 60;
const yOf = (v: number) => PLOT_BOTTOM - v * 2.2;
const barX = (i: number) => PLOT_LEFT + i * BAND + (BAND - BAR_W) / 2;
const barPath = (i: number, v: number) => {
  const x = barX(i), y = yOf(v), r = 3, w = BAR_W;
  return `M ${x} ${PLOT_BOTTOM} V ${y + r} Q ${x} ${y} ${x + r} ${y} H ${x + w - r} Q ${x + w} ${y} ${x + w} ${y + r} V ${PLOT_BOTTOM} Z`;
};
const fmtN = (n: number) => n.toLocaleString("en-US");
const fmtUSD = (n: number) => "$" + Math.round(n).toLocaleString("en-US");

// Sparkline paths: 3-month centered rolling mean of monthly medians.
const smooth = (s: number[]) => s.map((_, i) => {
  const w = s.slice(Math.max(0, i - 1), Math.min(s.length, i + 2));
  return w.reduce((a, b) => a + b, 0) / w.length;
});
const sparkline = (series: number[]) => {
  const s = smooth(series);
  const min = Math.min(...s), max = Math.max(...s), span = max - min || 1;
  const px = (i: number) => 4 + (i * 104) / (s.length - 1);
  const py = (v: number) => 30 - ((v - min) / span) * 24;
  const d = s.map((v, i) => `${i === 0 ? "M" : "L"} ${px(i).toFixed(1)} ${py(v).toFixed(1)}`).join(" ");
  return { d, ex: px(s.length - 1).toFixed(1), ey: py(s[s.length - 1]).toFixed(1) };
};
const pulseCards = PULSE.map((p) => ({ ...p, spark: sparkline(p.series) }));

// The Apple Valley builder case (NorthstarMLS price history, buyer side, closed Jan 2026)
const CASE_STEPS = ["$464,990", "$459,990", "$449,990", "$439,990", "$434,990"];
---

<BaseLayout title={title} description={description} noindex={true}>

<script is:inline>document.documentElement.classList.add('js');</script>

<div class="progress" aria-hidden="true"><div class="progress-fill" id="progress-fill"></div></div>

<nav class="doc-nav">
  <a href="/" class="name">Mark Gores</a>
  <div class="nav-meta">A Marketing Plan · 2026</div>
</nav>

<main class="doc">

  <!-- COVER -->
  <section class="cover" id="top">
    <div class="cover-content">
      <div class="doc-label">A Marketing Plan</div>
      <h1>How your house gets&nbsp;sold.</h1>
      <p class="cover-text">
        This is the plan I run for every listing: a price built on market evidence instead of flattery, preparation that removes objections before they get expensive, media buyers actually stop for, and a written report every week so you always know where things stand.
      </p>
      <p class="cover-text">
        It's all on this page, in writing, because claims you can check beat claims you have to take on faith.
      </p>
      <div class="cover-signature">Mark</div>
      <div class="cover-sub">Mark Gores · RE/MAX Advantage Plus · 612-201-5447</div>
    </div>

    <aside class="doc-card" data-rv>
      <div class="doc-card-label">The market this plan runs in</div>
      <div class="chip-rows">
        <div class="chip-row"><span class="chip-v">{TOPLINE.sold12}</span><span class="chip-l">homes sold, last 12 months</span></div>
        <div class="chip-row"><span class="chip-v">{TOPLINE.medDom} days</span><span class="chip-l">median time to find a buyer</span></div>
        <div class="chip-row"><span class="chip-v">{TOPLINE.medClose}</span><span class="chip-l">median sale price</span></div>
        <div class="chip-row"><span class="chip-v">{TOPLINE.actives}</span><span class="chip-l">homes on the market right now</span></div>
      </div>
      <p class="doc-card-foot">
        South metro single family resales: Prior Lake, Savage, Shakopee, Lakeville, Burnsville, Apple Valley, Eagan. Pulled from my MLS database {AS_OF}.
      </p>
      <p class="doc-card-foot web-only">This page prints as a brochure. Cmd+P if you'd rather hold paper.</p>
    </aside>

    <div class="versus" data-rv>
      <div class="versus-head">
        <span class="versus-title">The short version</span>
        <span class="versus-meta">The rest of the page is the proof · about an 8 minute read</span>
      </div>
      <div class="versus-cols" aria-hidden="true"><span>The standard playbook</span><span>This plan</span></div>
      <div class="versus-row"><span>A price quoted at your kitchen table</span><span>Three numbers in writing, before you commit to anything</span></div>
      <div class="versus-row"><span>Live whenever the photos are done</span><span>One prepared launch, because the first 14 days decide your price</span></div>
      <div class="versus-row"><span>30 photos, zero words</span><span>A caption on every photo, listing copy written by a person</span></div>
      <div class="versus-row"><span>"Call me if you have questions"</span><span>A written report every week, good news or not</span></div>
      <div class="versus-row"><span>Fees quoted in person, on request</span><span>2.7%, published right on this page</span></div>
    </div>
  </section>

  <!-- CONTENTS -->
  <section class="toc" aria-label="Contents">
    <div class="section-label">In this plan</div>
    <ol class="toc-list">
      <li><a href="#market"><span class="toc-num">01</span> The market right now</a></li>
      <li><a href="#pricing"><span class="toc-num">02</span> Pricing: the evidence</a></li>
      <li><a href="#prep"><span class="toc-num">03</span> Getting the house ready</a></li>
      <li><a href="#media"><span class="toc-num">04</span> The marketing</a></li>
      <li><a href="#launch"><span class="toc-num">05</span> The launch</a></li>
      <li><a href="#loop"><span class="toc-num">06</span> The feedback loop</a></li>
      <li><a href="#offers"><span class="toc-num">07</span> Offers &amp; negotiation</a></li>
      <li><a href="#fee"><span class="toc-num">08</span> The fee</a></li>
      <li><a href="#faq"><span class="toc-num">09</span> Questions sellers ask</a></li>
      <li><a href="#next"><span class="toc-num">10</span> Who's behind this &amp; next steps</a></li>
    </ol>
  </section>

  <!-- 01 MARKET -->
  <section class="market" id="market">
    <div class="section-label">01 · The market right now</div>
    <h2>Read the market before you price against it.</h2>
    <p class="section-intro">
      Everything in this section comes from NorthstarMLS closed records for seven south metro cities, single family resales only, new construction excluded. My database syncs with the MLS every 15 minutes; these figures were pulled {AS_OF}. Check them against anything you like.
    </p>

    <div class="pulse-grid">
      {pulseCards.map((p) => (
        <div class="pulse-card" data-rv>
          <div class="pulse-city">{p.city}</div>
          <div class="pulse-price">{fmtUSD(p.medClose)}</div>
          <div class="pulse-meta">{p.n} sales · {p.medDom} days median · ${p.ppsf}/sqft</div>
          <svg class="spark" viewBox="0 0 112 36" aria-label={`Monthly median sale price trend for ${p.city}`} role="img">
            <path d={p.spark.d} fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx={p.spark.ex} cy={p.spark.ey} r="2.5" fill="var(--accent)" />
          </svg>
          <div class="pulse-spark-label">Monthly median, smoothed · Jul '24 to Jun '26</div>
        </div>
      ))}
      <div class="pulse-card pulse-note" data-rv>
        <p>
          Half of last year's sellers found their buyer inside about two weeks. This is a quick, price-sensitive market: it rewards the right opening number and quietly punishes the wrong one. The next section shows by how much.
        </p>
        <p class="pulse-note-sub">There are also about {TOPLINE.newCon} new construction listings active out here. Builders run a different playbook, so they're kept out of every number on this page.</p>
      </div>
    </div>
  </section>

  <!-- 02 PRICING EVIDENCE -->
  <section class="pricing" id="pricing">
    <div class="section-label">02 · Pricing: the evidence</div>
    <h2>The first two weeks decide your price.</h2>
    <p class="section-intro">
      I pulled every single family resale that closed in these seven cities over the last 24 months, {fmtN(N24)} sales, and grouped them by how long they took to find a buyer. Then I asked one question: how often did the seller get asking price or better?
    </p>

    <figure class="curve" data-rv>
      <figcaption class="curve-head">
        <div class="curve-title">Sold at or over asking price, by days on market</div>
        <div class="curve-filters web-only" role="group" aria-label="Filter by price band">
          <button class="chip is-on" data-band="all" aria-pressed="true">All homes</button>
          <button class="chip" data-band="under400" aria-pressed="false">Under $400K</button>
          <button class="chip" data-band="b400600" aria-pressed="false">$400K to $600K</button>
          <button class="chip" data-band="over600" aria-pressed="false">$600K+</button>
        </div>
      </figcaption>

      <svg id="curve-svg" viewBox={`0 0 ${CW} ${CH}`} role="img" aria-label="Bar chart: share of homes sold at or over asking price, grouped by days on market">
        {[0, 25, 50, 75, 100].map((v) => (
          <g>
            <line x1={PLOT_LEFT - 6} y1={yOf(v)} x2={PLOT_RIGHT} y2={yOf(v)} class="grid" />
            <text x={PLOT_LEFT - 12} y={yOf(v) + 4} class="tick">{v}%</text>
          </g>
        ))}
        {CURVE.all.map((b, i) => (
          <g class="bar-g">
            <title>{`${b.bucket} days: ${b.pct}% sold at or over ask · median ${b.medRatio}% of ask · ${fmtN(b.n)} sales`}</title>
            <path id={`bar-${i}`} class="bar" d={barPath(i, b.pct)} />
            <text id={`bval-${i}`} class="bar-val" x={barX(i) + BAR_W / 2} y={yOf(b.pct) - 10} text-anchor="middle">{b.pct}%</text>
            <text class="bar-cat" x={barX(i) + BAR_W / 2} y={PLOT_BOTTOM + 22} text-anchor="middle">{b.bucket}</text>
            <text id={`bn-${i}`} class="bar-n" x={barX(i) + BAR_W / 2} y={PLOT_BOTTOM + 40} text-anchor="middle">{fmtN(b.n)} sales</text>
          </g>
        ))}
        <text x={PLOT_LEFT} y={CH - 4} class="axis-note">Days on market before finding a buyer</text>
      </svg>
      <div class="curve-foot">
        <span id="curve-n">Showing all {fmtN(N24)} sales.</span><span class="web-only"> Hover any bar for the median sale-to-list figure.</span>
      </div>
    </figure>

    <div class="callout" data-rv>
      <div class="callout-label">What it costs to miss the window</div>
      <p>
        Homes that sold in their first two weeks got a median <strong>101.0% of asking</strong>. Homes that took more than 90 days got <strong>97.8%</strong>. On a $500,000 house, that gap is about <strong>$16,000</strong>. And it's measured against the final asking price, after any cuts along the way, so the true cost of starting high is larger than this chart can show.
      </p>
    </div>

    <p>
      To be fair about what this is: nobody can prove the slow listings would have done better priced right on day one. But I've watched this market for 22 years, and this pattern is the most expensive lesson sellers learn. My job is to make sure you learn it from other people's listings instead of yours.
    </p>

    <h3 class="sub-heading">So here's how I set your number</h3>
    <p>
      Comps matched the way an appraiser matches them: size, age, basement finish, street. Time adjustments for a moving market, and a street premium where the data shows one. You get three numbers in writing before you commit to anything:
    </p>

    <div class="tier-row" data-rv>
      <div class="tier-card">
        <div class="tier-label">Safe</div>
        <div class="tier-note">The certainty end. Prices ahead of the comps to compress your timeline.</div>
      </div>
      <div class="tier-card recommended">
        <div class="tier-label">Recommended</div>
        <div class="tier-note">Where the comps, the street, and your home's condition actually point.</div>
      </div>
      <div class="tier-card">
        <div class="tier-label">Stretch</div>
        <div class="tier-note">Tests the ceiling. Takes patience, great presentation, and a plan for what we do if the market shrugs.</div>
      </div>
    </div>

    <p>
      The call is yours, and I'll list at your number. What I won't do is inflate mine to win your signature. Agents call that buying the listing: quote high, get the contract, then walk you down with cuts once the sign's in the yard. The chart above is what that strategy costs. If my number comes in lower than another agent's, ask us both for our comps in writing. Mine will already be in your hands.
    </p>

    <div class="aside-note" data-rv>
      <div class="aside-note-label">A note on round numbers</div>
      <p>
        Old pricing wisdom says end in 9: list at $564,900 instead of $565,000. The data doesn't back that up anymore. Round numbers signal confidence and show up in more searches, because buyers filter in $25k and $50k chunks. I'd rather the extra hundred bucks end up in your pocket than in a superstition.
      </p>
    </div>
  </section>

  <!-- 03 PREP -->
  <section class="prep" id="prep">
    <div class="section-label">03 · Getting the house ready</div>
    <h2>Cheap fixes now beat expensive credits later.</h2>
    <p class="section-intro">
      Buyers don't price problems the way you would. A $300 repair left undone reads as a $3,000 doubt in an offer, and three of them read as "what else is wrong?" So before photos, we walk the house together and deal with it:
    </p>
    <ul class="check-list" data-rv>
      <li><strong>A photo-ready punch list</strong> from our walkthrough: what to fix, what to leave, what nobody will notice. Ruthlessly practical, not a renovation pitch.</li>
      <li><strong>A professional staging consultation</strong>, included. Usually it's editing, not furniture rental: what to remove, what to move, which rooms carry the listing.</li>
      <li><strong>Pre-inspection guidance</strong> if the house needs it, so surprises show up while they're still cheap and private.</li>
      <li><strong>No artificial deadlines.</strong> The house goes live when it's ready, not when a calendar says so. The launch window matters too much to waste it on an unready house.</li>
    </ul>
  </section>

  <!-- 04 MARKETING -->
  <section class="media" id="media">
    <div class="section-label">04 · The marketing</div>
    <h2>What I'll actually do to market your house.</h2>
    <p class="section-intro">
      Here's something most agents won't say out loud: nearly every agent you interview has the same basic toolbox. The MLS feeds Zillow, Realtor.com, Redfin, and hundreds of other sites automatically, for every listing, no matter who lists it. Syndication isn't a strategy, it's plumbing, and anyone presenting "exposure on 2,000 websites" as their edge is selling you the water main. What actually separates listings is the finish work: what a buyer sees after the click, and how the people in the transaction get treated. That's where I spend my time.
    </p>

    <div class="media-grid">
      <div class="media-card" data-rv>
        <h3>Photography</h3>
        <p>Professional interior and exterior photography plus aerial shots, scheduled when the house and the light are ready. Photos are the showing before the showing; they get treated that way.</p>
      </div>
      <div class="media-card" data-rv>
        <h3>A caption on every photo</h3>
        <p>Most agents upload 30 photos and zero words. I write a caption for each one, because a caption answers the question a photo raises.</p>
        <div class="caption-demo">
          <span class="caption-demo-label">e.g.</span>
          "New LVP flooring, 2024." · "Heated, insulated 3-car garage."
        </div>
      </div>
      <div class="media-card" data-rv>
        <h3>Copy written by me</h3>
        <p>The listing description is written by a person who's walked your house, not generated by a tool that hasn't. It sells the two or three things that make your house your house.</p>
      </div>
      <div class="media-card" data-rv>
        <h3>Paid reach</h3>
        <p>Targeted online advertising, a social campaign, plus print and radio. Not because every channel wins every time, but because the buyer you need only has to be found once.</p>
      </div>
      <div class="media-card" data-rv>
        <h3>A page of its own</h3>
        <p>Before you've signed anything, your house gets a private page like this one: your comps, your numbers, your street's history, written by me. Not a template with your address pasted in. You're reading the quality bar right now.</p>
      </div>
      <div class="media-card" data-rv>
        <h3>Easy to show, easy to offer</h3>
        <p>Buyers' agents talk to each other. I answer their questions fast, keep showings simple, and respond to every offer promptly. None of that fits on a flyer. All of it shows up in how smoothly your sale runs.</p>
      </div>
    </div>
  </section>

  <!-- 05 LAUNCH -->
  <section class="launch" id="launch">
    <div class="section-label">05 · The launch</div>
    <h2>Quiet prep, then one loud week.</h2>
    <p class="section-intro">
      The evidence section is why launch discipline matters: your leverage peaks in the first 14 days and never comes back. Every house is different, but the sequence isn't:
    </p>
    <ol class="timeline" data-rv>
      <li class="phase">
        <div class="phase-tag">Two weeks out</div>
        <p>Walkthrough, punch list, staging consult. Photography scheduled. Pricing proposal finalized in writing.</p>
      </li>
      <li class="phase">
        <div class="phase-tag">One week out</div>
        <p>Photos shot and captioned. Copy written. The MLS entry gets built completely before it goes anywhere.</p>
      </li>
      <li class="phase">
        <div class="phase-tag">Day one</div>
        <p>Live on the MLS and everywhere it feeds, ads on, showings open. Nothing dribbles out early and stale.</p>
      </li>
      <li class="phase">
        <div class="phase-tag">Weeks one &amp; two</div>
        <p>The decisive window. Showings and feedback tracked daily, and you get the first written report before the first weekend is over.</p>
      </li>
    </ol>
  </section>

  <!-- 06 LOOP -->
  <section class="loop" id="loop">
    <div class="section-label">06 · The feedback loop</div>
    <h2>You shouldn't have to ask what's happening.</h2>
    <p class="section-intro">
      Every week you get a written report: showings, buyer feedback, online traffic, my read of it, and a specific recommendation. It shows up whether the news is good or not. Here's the shape of one:
    </p>

    <div class="report" data-rv>
      <div class="report-head">
        <span class="report-title">Weekly listing report · Week 2</span>
        <span class="report-badge">Illustrative example</span>
      </div>
      <div class="report-rows">
        <div class="report-row"><span>Showings</span><span class="mono">9 this week · 17 total</span></div>
        <div class="report-row"><span>Online</span><span class="mono">4,210 views · 212 saves</span></div>
        <div class="report-row"><span>Feedback themes</span><span class="mono">"kitchen" positive ×4 · "backyard smaller than expected" ×2</span></div>
        <div class="report-row"><span>My read</span><span class="mono">Traffic strong, weekend two conversion soft</span></div>
        <div class="report-row"><span>Recommendation</span><span class="mono">Hold price through weekend three. Revisit Tuesday if no offer.</span></div>
      </div>
