    padding: 0.85rem 0;
    border-bottom: 1px solid rgba(232, 223, 208, 0.7);
  }
  .chip-row:last-child { border-bottom: none; }
  .chip-v {
    font-family: var(--serif);
    font-size: 1.7rem;
    color: var(--dark);
    line-height: 1;
    white-space: nowrap;
  }
  .chip-l {
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--warm);
    line-height: 1.5;
  }
  .doc-card-foot {
    margin: 1.1rem 0 0;
    font-size: 0.78rem;
    font-style: italic;
    color: var(--text-light);
    line-height: 1.55;
  }

  /* ===================== SHORT VERSION / VERSUS ===================== */
  .versus {
    grid-column: 1 / -1;
    margin-top: 3rem;
    padding: 1.75rem 2rem 1.25rem;
    background: white;
    border: 1px solid var(--light-warm);
    border-radius: 3px;
  }
  .versus-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .versus-title {
    font-family: var(--serif);
    font-size: 1.2rem;
    color: var(--dark);
  }
  .versus-meta {
    font-family: var(--mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--warm);
  }
  .versus-cols {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 2rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--light-warm);
  }
  .versus-cols span {
    font-family: var(--mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--warm);
  }
  .versus-row {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 2rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid rgba(232, 223, 208, 0.6);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .versus-row:last-child { border-bottom: none; }
  .versus-row span:first-child { color: var(--text-light); font-style: italic; }
  .versus-row span:last-child { color: var(--dark); }

  /* ===================== TOC ===================== */
  .toc { padding: 0 3rem 4rem !important; }
  .toc-list {
    list-style: none;
    padding: 1.75rem 0 0;
    margin: 0;
    border-top: 1px solid var(--light-warm);
    columns: 2;
    column-gap: 4rem;
    max-width: 800px;
  }
  .toc-list li { break-inside: avoid; }
  main.doc .toc-list a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.45rem 0;
    font-family: var(--body);
    font-size: 1rem;
    color: var(--text);
    text-decoration: none;
    border-bottom: none;
  }
  main.doc .toc-list a:hover { color: var(--accent); }
  .toc-num {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--warm);
    letter-spacing: 0.08em;
  }

  /* ===================== 01 MARKET ===================== */
  .market { border-top: 1px solid var(--light-warm); }
  .pulse-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-top: 2.5rem;
  }
  .pulse-card {
    padding: 1.5rem 1.5rem 1.25rem;
    background: white;
    border: 1px solid var(--light-warm);
    border-radius: 3px;
  }
  .pulse-city {
    font-family: var(--serif);
    font-size: 1.1rem;
    color: var(--dark);
    margin-bottom: 0.75rem;
  }
  .pulse-price {
    font-family: var(--serif);
    font-size: 1.7rem;
    color: var(--dark);
    line-height: 1;
    margin-bottom: 0.6rem;
  }
  .pulse-meta {
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--warm);
    margin-bottom: 1rem;
    line-height: 1.6;
  }
  .spark { width: 100%; height: auto; display: block; }
  .pulse-spark-label {
    font-family: var(--mono);
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-light);
    margin-top: 0.5rem;
  }
  .pulse-note {
    background: var(--light-warm);
    border-color: var(--light-warm);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .pulse-note p {
    font-size: 0.95rem !important;
    color: var(--text) !important;
    margin-bottom: 0.75rem !important;
    line-height: 1.6 !important;
  }
  .pulse-note .pulse-note-sub {
    font-size: 0.8rem !important;
    color: var(--text-light) !important;
    font-style: italic;
    margin-bottom: 0 !important;
  }

  /* ===================== 02 EVIDENCE CHART ===================== */
  .pricing { border-top: 1px solid var(--light-warm); }
  .curve {
    margin: 2.5rem 0 2rem;
    padding: 2rem 2rem 1.5rem;
    background: white;
    border: 1px solid var(--light-warm);
    border-radius: 3px;
  }
  .curve-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .curve-title {
    font-family: var(--serif);
    font-size: 1.2rem;
    color: var(--dark);
  }
  .curve-filters { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .chip {
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--warm);
    background: transparent;
    border: 1px solid var(--light-warm);
    border-radius: 2px;
    padding: 0.45rem 0.8rem;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .chip:hover { border-color: var(--warm); color: var(--dark); }
  .chip.is-on {
    background: var(--dark);
    border-color: var(--dark);
    color: var(--cream);
  }
  #curve-svg { width: 100%; height: auto; display: block; }
  #curve-svg .grid { stroke: var(--light-warm); stroke-width: 1; }
  #curve-svg .tick {
    font-family: var(--mono);
    font-size: 11px;
    fill: var(--warm);
    text-anchor: end;
  }
  #curve-svg .bar { fill: var(--accent); transition: d 0.35s ease; }
  #curve-svg .bar-g:hover .bar { fill: var(--dark); }
  #curve-svg .bar-val {
    font-family: var(--mono);
    font-size: 13px;
    fill: var(--dark);
  }
  #curve-svg .bar-cat {
    font-family: var(--mono);
    font-size: 11px;
    fill: var(--text);
    letter-spacing: 0.04em;
  }
  #curve-svg .bar-n {
    font-family: var(--mono);
    font-size: 10px;
    fill: var(--warm);
  }
  #curve-svg .axis-note {
    font-family: var(--mono);
    font-size: 10px;
    fill: var(--warm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .curve-foot {
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--warm);
    margin-top: 0.75rem;
    line-height: 1.6;
  }

  .callout {
    padding: 1.75rem 2.25rem;
    background: var(--dark);
    color: var(--cream);
    border-radius: 3px;
    margin: 2rem 0;
    max-width: 900px;
  }
  .callout-label {
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  .callout p {
    color: rgba(245, 240, 232, 0.85) !important;
    font-size: 1.02rem !important;
    margin-bottom: 0 !important;
    max-width: none !important;
  }
  main.doc section .callout p strong { color: var(--cream); }

  .tier-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin: 2rem 0 2.5rem;
  }
  .tier-card {
    padding: 1.75rem 1.5rem;
    background: white;
    border: 1px solid var(--light-warm);
    border-radius: 3px;
  }
  .tier-card.recommended { background: var(--dark); border-color: var(--dark); }
  .tier-label {
    font-family: var(--mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--warm);
    margin-bottom: 0.75rem;
  }
  .tier-card.recommended .tier-label { color: var(--accent); }
  .tier-note {
    font-family: var(--body);
    font-size: 0.95rem;
    color: var(--text-light);
    line-height: 1.55;
  }
  .tier-card.recommended .tier-note { color: rgba(245, 240, 232, 0.75); }

  .aside-note {
    margin-top: 2.5rem;
    padding: 1.75rem 2rem;
    background: white;
    border: 1px solid var(--light-warm);
    border-left: 3px solid var(--sage);
    border-radius: 3px;
    max-width: 820px;
  }
  .aside-note-label {
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--sage);
    margin-bottom: 0.75rem;
  }
  .aside-note p {
    margin-bottom: 0 !important;
    font-size: 0.98rem !important;
    color: var(--text) !important;
    max-width: none !important;
  }

  /* ===================== 03 PREP ===================== */
  .prep { border-top: 1px solid var(--light-warm); }
  .check-list {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    max-width: 820px;
  }
  .check-list li {
    padding: 1.1rem 0 1.1rem 2rem;
    position: relative;
    font-size: 1rem;
    color: var(--text);
    line-height: 1.65;
    border-top: 1px solid var(--light-warm);
  }
  .check-list li:first-child { border-top: none; }
  .check-list li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    top: 1.1rem;
    color: var(--accent);
    font-weight: 600;
  }
  .check-list strong { color: var(--dark); font-weight: 500; }

  /* ===================== 04 MEDIA ===================== */
  .media { border-top: 1px solid var(--light-warm); }
  .media-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  .media-card {
    padding: 2rem 2rem 1.75rem;
    background: white;
    border: 1px solid var(--light-warm);
    border-radius: 3px;
  }
  .media-card h3 {
    font-family: var(--serif);
    font-size: 1.25rem;
    color: var(--dark);
    margin-bottom: 0.75rem;
    font-weight: 400;
  }
  .media-card p {
    font-size: 0.97rem !important;
    margin-bottom: 0 !important;
    line-height: 1.6 !important;
  }
  .caption-demo {
    margin-top: 1rem;
    padding: 0.9rem 1.1rem;
    background: var(--cream);
    border: 1px solid var(--light-warm);
    border-radius: 2px;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--text);
    line-height: 1.7;
  }
  .caption-demo-label {
    color: var(--warm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-right: 0.4rem;
  }

  /* ===================== 05 LAUNCH ===================== */
  .timeline {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }
  .phase {
    padding: 1.5rem 1.4rem;
    background: white;
    border: 1px solid var(--light-warm);
    border-top: 3px solid var(--accent);
    border-radius: 3px;
  }
  .phase-tag {
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  .phase p {
    font-size: 0.92rem !important;
    margin-bottom: 0 !important;
    line-height: 1.6 !important;
    color: var(--text) !important;
  }

  /* ===================== 06 LOOP / REPORT ===================== */
  .loop { border-top: 1px solid var(--light-warm); }
  .report {
    background: var(--dark);
    color: var(--cream);
    border-radius: 3px;
    padding: 2rem 2.25rem 1.5rem;
    margin: 2rem 0;
    max-width: 860px;
  }
  .report-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(245, 240, 232, 0.15);
    margin-bottom: 0.5rem;
  }
  .report-title {
    font-family: var(--serif);
    font-size: 1.15rem;
    color: var(--cream);
  }
  .report-badge {
    font-family: var(--mono);
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--dark);
    background: var(--accent);
    padding: 0.25rem 0.6rem;
    border-radius: 2px;
  }
  .report-row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1.5rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(245, 240, 232, 0.1);
    font-size: 0.95rem;
    color: rgba(245, 240, 232, 0.65);
  }
  .report-row:last-child { border-bottom: none; }
  .report-row .mono {
    font-family: var(--mono);
    font-size: 0.82rem;
    color: rgba(245, 240, 232, 0.9);
    line-height: 1.6;
  }
  .report-foot {
    font-family: var(--body);
    font-style: italic;
    font-size: 0.82rem;
    color: rgba(245, 240, 232, 0.5);
    padding-top: 1rem;
  }

  /* ===================== 07 OFFERS / CASE ===================== */
  .offers { border-top: 1px solid var(--light-warm); }
  .case {
    padding: 2rem 2.25rem;
    background: white;
    border: 1px solid var(--light-warm);
    border-left: 3px solid var(--accent);
    border-radius: 3px;
    max-width: 860px;
    margin-top: 2rem;
  }
  .case-label {
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .case p {
    font-size: 1rem !important;
    color: var(--text) !important;
    max-width: none !important;
  }
  .case p:last-child { margin-bottom: 0 !important; }
  .mono-strip {
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--warm);
    background: var(--cream);
    border: 1px solid var(--light-warm);
    border-radius: 2px;
    padding: 0.9rem 1.2rem;
    margin: 1.25rem 0;
    line-height: 1.8;
  }
  .case-final {
    color: var(--dark);
    font-weight: 600;
    white-space: nowrap;
  }
  .case-arrow { color: var(--light-warm); }

  /* ===================== 08 FEE ===================== */
  .fee { border-top: 1px solid var(--light-warm); }
  .fee-breakdown {
    margin: 2.5rem 0;
    border: 1px solid var(--light-warm);
    border-radius: 3px;
    overflow: hidden;
    background: white;
    max-width: 900px;
  }
  .fee-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--light-warm);
    align-items: start;
  }
  .fee-row:last-child { border-bottom: none; }
  .fee-row.fee-total { background: var(--light-warm); border-top: 2px solid var(--warm); }
  .fee-title {
    font-family: var(--serif);
    font-size: 1.15rem;
    color: var(--dark);
    margin-bottom: 0.3rem;
  }
  .fee-sub {
    font-family: var(--body);
    font-size: 0.9rem;
    color: var(--text-light);
    line-height: 1.55;
    max-width: 560px;
  }
  .fee-amount {
    font-family: var(--serif);
    font-size: 2rem;
    color: var(--accent);
    line-height: 1;
    white-space: nowrap;
  }

  .included {
    margin: 2rem 0 2.5rem;
    padding: 1.5rem 2rem 1.25rem;
    background: white;
    border: 1px solid var(--light-warm);
    border-radius: 3px;
    max-width: 900px;
  }
  .included-label {
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .included-list {
    list-style: none;
    padding: 0;
    margin: 0;
    columns: 3;
    column-gap: 2rem;
  }
  .included-list li {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--text);
    padding: 0.3rem 0 0.3rem 1.1rem;
    position: relative;
    break-inside: avoid;
    line-height: 1.5;
  }
  .included-list li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .calc {
    padding: 2.5rem;
    background: var(--dark);
    color: var(--cream);
    border-radius: 3px;
    margin-top: 2.5rem;
    max-width: 900px;
  }
  .calc-label {
    font-family: var(--mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }
  .calc-input-wrap { display: block; margin-bottom: 1rem; }
  .calc-input-label {
    display: block;
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(245, 240, 232, 0.55);
    margin-bottom: 0.5rem;
  }
  .calc input[type="text"] {
    font-family: var(--serif);
    font-size: 2.2rem;
    color: var(--cream);
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(245, 240, 232, 0.25);
    padding: 0.2rem 0 0.4rem;
    width: 100%;
    max-width: 320px;
  }
  .calc input[type="text"]:focus { outline: none; border-bottom-color: var(--accent); }
  .calc input[type="range"] {
    width: 100%;
    max-width: 480px;
    accent-color: var(--accent);
    margin: 0.5rem 0 1.5rem;
  }
  .calc-rows { display: flex; flex-direction: column; }
  .calc-row {
    display: grid;
    grid-template-columns: 1fr auto;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(245, 240, 232, 0.1);
    font-size: 1rem;
    color: rgba(245, 240, 232, 0.85);
  }
  .calc-row .mono { font-family: var(--mono); font-size: 0.95rem; }
  .calc-row.calc-final {
    border-bottom: none;
    border-top: 2px solid var(--accent);
    padding-top: 1rem;
    margin-top: 0.75rem;
    font-size: 1.1rem;
    color: var(--cream);
  }
  .calc-row.calc-final .mono { font-size: 1.2rem; color: var(--accent); }
  .calc-row.calc-clear {
    border-bottom: none;
    color: var(--cream);
    padding-top: 0.9rem;
  }
  .calc-row.calc-clear .mono { font-size: 1.1rem; color: var(--cream); }
  .calc-compare {
    margin: 1.25rem 0 0 !important;
    font-size: 0.95rem !important;
    color: rgba(245, 240, 232, 0.7) !important;
    max-width: none !important;
  }
  main.doc section .calc-compare strong { color: var(--cream); }
  .calc-note {
    margin: 1.5rem 0 0 !important;
    font-size: 0.82rem !important;
    color: rgba(245, 240, 232, 0.5) !important;
    font-style: italic;
    line-height: 1.55 !important;
    max-width: none !important;
  }
  .table-wrap { overflow-x: auto; }
  .fee-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .fee-table thead { background: rgba(245, 240, 232, 0.08); color: var(--cream); }
  .fee-table th {
    font-family: var(--mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.8rem 0.9rem;
    text-align: left;
    font-weight: 400;
  }
  .fee-table th.r, .fee-table td.r { text-align: right; }
  .fee-table td {
    font-family: var(--mono);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    padding: 0.8rem 0.9rem;
    border-bottom: 1px solid rgba(245, 240, 232, 0.1);
    color: rgba(245, 240, 232, 0.85);
    white-space: nowrap;
  }
  .fee-table tr:last-child td { border-bottom: none; }
  .calc-static.screen-hidden { display: none; }

  /* ===================== 09 FAQ ===================== */
  .faq { border-top: 1px solid var(--light-warm); }
  .qa-list { max-width: 820px; margin-top: 2rem; }
  .qa { padding: 1.75rem 0; border-top: 1px solid var(--light-warm); }
  .qa:first-child { border-top: none; }
  .qa h3 {
    font-family: var(--serif);
    font-size: 1.25rem;
    color: var(--dark);
    font-weight: 400;
    margin-bottom: 0.75rem;
  }
  .qa p { margin-bottom: 0 !important; font-size: 1rem !important; }

  /* ===================== 10 WHO + NEXT ===================== */
  .next { border-top: 1px solid var(--light-warm); }
  .who-row {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 1.5rem;
