---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Prior Lake & South Metro Expert | Mark Gores — Realtor";
const description = "Grew up in Prior Lake, still live here. I know which streets flood, which builders cut corners, and what it's actually like to live here. Not just my market — my home.";
---

<BaseLayout title={title} description={description}>
  <Header />

  <main>
    <h1 class="page-title">Prior Lake & the South Metro</h1>

    <p class="intro reveal">
      I grew up here. My kids go to Prior Lake schools. This isn't just my market—it's my home.
    </p>

    <div class="content">
      <section class="section reveal" data-delay="100">
        <h2>What that actually means for you</h2>
        <p>
          When you ask me about a neighborhood, I'm not Googling it. I'm telling you what I've learned from growing up here and living here my whole life.
        </p>
        <p>
          I know which streets actually get lake access versus which ones just have a view. I know which builders in the early 2000s cut corners on foundations. I know where the school bus routes run, which parks get packed on weekends, where to get the best burger, and which "quiet streets" get highway noise when the wind shifts east.
        </p>
        <p>
          I can tell you which parts of town are great for young families and which ones are better suited for empty nesters looking to downsize. I know what the neighborhood dynamics are like in ways that don't show up on Zillow or Realtor.com.
        </p>
        <p>
          If you're moving to Prior Lake, I can tell you what it's <em>actually</em> like to live here—not the chamber of commerce version.
        </p>
      </section>

      <section class="section featured reveal" data-delay="200">
        <h2>Something I built for the community</h2>
        <div class="project-card">
          <div class="project-info">
            <h3>Prior Lake Events</h3>
            <p>
              A town of 28,000 people didn't have one central place to find out what's happening this weekend. Farmers market dates, high school games, community events—all scattered across Facebook groups and city newsletters nobody reads.
            </p>
            <p>
              So I built a weekly email that rounds it all up. One email, every week, everything that's happening in Prior Lake.
            </p>
            <div class="project-stats">
              <span class="stat"><strong>625+</strong> subscribers</span>
              <span class="stat"><strong>70%</strong> open rate</span>
            </div>
            <p class="project-note">
              I started it because the town needed it. It's a community project first—I sell a few small ad spots to keep the lights on, but that's it.
            </p>
          </div>
          <a href="https://priorlakeevents.com" target="_blank" rel="noopener" class="btn">Visit Prior Lake Events →</a>
        </div>
      </section>

      <section class="section reveal" data-delay="300">
        <h2>Areas I know best</h2>
        <div class="area-grid">
          <div class="area">
            <strong>Prior Lake</strong>
            <span>Home base. Grew up here, raised my kids here. I know it block by block.</span>
          </div>
          <div class="area">
            <strong>Savage</strong>
            <span>Right next door. Sold a lot of homes here over the years.</span>
          </div>
          <div class="area">
            <strong>Shakopee</strong>
            <span>Watched it transform from a small town to one of the fastest-growing cities in the metro.</span>
          </div>
          <div class="area">
            <strong>Lakeville</strong>
            <span>Especially the west side—the new development over there has been interesting to watch.</span>
          </div>
          <div class="area">
            <strong>Burnsville · Apple Valley · Eagan</strong>
            <span>Work here regularly. Strong established neighborhoods with good long-term value.</span>
          </div>
        </div>
        <p class="area-note">
          I can help anywhere in the Twin Cities metro, but these are the areas where my knowledge runs deepest. If you're looking out here, you're talking to the right person.
        </p>
      </section>

      <div class="cta-section reveal" data-delay="350">
        <p>Thinking about buying or selling in the south metro?</p>
        <div class="cta-buttons">
          <a href="/contact" class="btn">Let's talk</a>
          <a href="/work-with-me" class="btn btn-secondary">See how I work</a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-md);
  }

  .intro {
    font-size: var(--text-lg);
    margin-bottom: var(--space-xl);
  }

  .content {
    max-width: 100%;
  }

  .section {
    margin-bottom: var(--space-xl);
  }

  .section h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-md);
    color: var(--color-accent);
  }

  .section p {
    margin-bottom: var(--space-md);
  }

  /* Featured project card */
  .featured {
    background-color: var(--color-highlight);
    margin-left: calc(-1 * var(--space-md));
    margin-right: calc(-1 * var(--space-md));
    padding: var(--space-lg);
    border-radius: var(--radius-md);
    transition: box-shadow 0.3s ease;
  }

  .featured:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }

  .project-card h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-sm);
    color: var(--color-text);
  }

  .project-stats {
    display: flex;
    gap: var(--space-lg);
    margin: var(--space-md) 0;
  }

  .project-stats .stat {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .project-stats strong {
    color: var(--color-accent);
    font-size: var(--text-lg);
  }

  .project-note {
    font-style: italic;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  /* Area grid */
  .area-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin: var(--space-md) 0;
  }

  .area {
    display: flex;
    flex-direction: column;
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--color-border);
    transition: padding-left 0.3s var(--ease-out-expo), background-color 0.3s ease;
  }

  .area:hover {
    padding-left: var(--space-sm);
    background-color: var(--color-highlight);
  }

  .area:last-child {
    border-bottom: none;
  }

  .area strong {
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }

  .area span {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .area-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-md);
  }

  .cta-section {
    margin-top: var(--space-lg);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .cta-section > p {
    margin-bottom: var(--space-md);
  }

  .cta-buttons {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }
</style>
