---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>

<nav aria-label="Primary">
  <a href="#" class="name">Mark Gores</a>
  <ul class="links">
    <li><a href="#selling">Selling</a></li>
    <li><a href="/vendors">Who to Call</a></li>
    <li><a href="#approach">How I Work</a></li>
    <li><a href="#proof">Proof</a></li>
    <li><a href="#community">Local</a></li>
    <li><a href="#contact">Contact</a></li>
  </ul>
</nav>

<main>

<!-- Hero -->
<div class="hero">
  <div class="hero-content">
    <div class="hero-label">Prior Lake, Minnesota · Since 2004</div>
    <h1>Some houses I'll tell you <em>not</em> to buy.</h1>
    <p class="hero-text">
      That house with the "great bones" that needs $80k in work? I'll tell you. The neighborhood that floods every spring? I'll mention it. The seller testing the market at 15% over comps? I'll save you the trouble.
    </p>
    <a href="#selling" class="hero-sell">Selling? Get the numbers on your house first →</a>
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-number">22</span>
        <span class="stat-label">Years in Real Estate</span>
      </div>
      <div class="stat">
        <span class="stat-number">40</span>
        <span class="stat-label">Years in Prior Lake</span>
      </div>
      <div class="stat">
        <span class="stat-number">5.0</span>
        <span class="stat-label">Stars on Zillow</span>
      </div>
    </div>
  </div>
  <div class="hero-image">
    <img src="/images/lake.jpg" alt="Aerial view of Prior Lake, Minnesota">
  </div>
</div>

<!-- How I Work -->
<section class="pitch" id="approach">
  <div class="pitch-inner">
    <div class="section-label">How I Work</div>
    <h2>I've watched people buy at the top, panic at the bottom, and stretch into mortgages that kept them up at night.</h2>
    <p>
      Twenty-two years of that changes how you do this job. I'm not trying to close you. I'm trying to make sure you're still happy with this decision in five years.
    </p>
    <p>
      I live here. My kids go to school here. I'll see you at Lakefront Park or the grocery store. I'd like that to be a good conversation.
    </p>

    <div class="approach-grid">
      <div class="approach-card">
        <h3>I'll respond fast</h3>
        <p>When people work with me, they feel like they're my only client. I pick up the phone. I answer the text. I don't let things sit.</p>
      </div>
      <div class="approach-card">
        <h3>I won't hound you</h3>
        <p>No drip campaigns. No "just checking in!" emails. When you're ready, I'm here. When you're not, I'll respect that.</p>
      </div>
      <div class="approach-card">
        <h3>I know the deals</h3>
        <p>Not the scripts. The deals. Inspections, negotiations, contingencies, title issues. The stuff that matters when money is on the line.</p>
      </div>
      <div class="approach-card">
        <h3>I'll be honest</h3>
        <p>Even when it costs me a commission. Especially then. You're making the biggest purchase of your life. You deserve someone in your corner, not on a sales floor.</p>
      </div>
    </div>
  </div>
</section>

<!-- For Sellers -->
<section class="sell" id="selling">
  <div class="section-label">If You're Selling</div>
  <div class="sell-content">
    <div>
      <h2>Send me your address. I'll run the numbers.</h2>
      <p>
        Comps from thousands of south metro sales, a recommended price range, and an estimated net for your house. In writing, before you've committed to anything.
      </p>
      <p>
        If the numbers look right to you, we'll talk through the rest: pricing strategy, the marketing, fees, timing. If they don't, you've lost nothing but the read.
      </p>
    </div>
    <a href="#contact" class="sell-card">
      <span class="sell-card-title">Get your numbers</span>
      <span class="sell-card-sub">Comps, a recommended range, an estimated net. Takes me about a day and costs you nothing.</span>
      <span class="sell-card-cta">Send your address →</span>
    </a>
  </div>
</section>

<!-- Testimonials -->
<section class="testimonials" id="proof">
  <div class="section-label">What People Say</div>
  <div class="testimonial-grid">
    <div class="testimonial">
      <blockquote>Moved to this community as total strangers. We asked locals who was the most knowledgeable, effective and trustworthy realtor. They said, "Oh, that would be Mark Gores." Since then Mark has handled 5 transactions for our family, ranging from $300K to $1MM.</blockquote>
      <cite>Bud · homebuyer</cite>
    </div>
    <div class="testimonial">
      <blockquote>Mark did a great job of communicating market conditions and helping us get the most value for our home. He was very responsive and helpful throughout the process.</blockquote>
      <cite>Marcus · home seller</cite>
    </div>
    <div class="testimonial">
      <blockquote>Fast response, did an excellent job advertising the home, had a showing and sold the property before ever getting a "for sale" sign out front. Everything went very smoothly. Mark answered all our questions quickly, provided sound advice on preparing to sell, and handled the entire process with professionalism.</blockquote>
      <cite>Robert · home seller</cite>
    </div>
    <div class="testimonial">
      <blockquote>We have owned 10 houses in our lifetimes and Mark provided the most professional and expert purchasing experience to date. He listened closely to our needs and delivered exactly what we were after in rapid fashion.</blockquote>
      <cite>John · homebuyer</cite>
    </div>
  </div>
</section>

<div class="divider"><hr></div>

<!-- The Person (merged with the built-for-the-neighbors cards) -->
<section class="personal" id="community">
  <div class="personal-inner">
    <div>
      <div class="section-label">The Person</div>
      <h2>Prior Lake since 1986.</h2>
      <p>
        University of Iowa for college, then right back. My kids are coming up through the Prior Lake schools. I can tell you which parks have the best sledding hills and which places do a steak right.
      </p>
      <p>
        When I'm not doing real estate, it's some mix of pickleball, pinball, cooking, and the boat.
      </p>
      <p>
        And I build websites for fun. This one's mine. These three are for the neighbors. All free. Use them or don't.
      </p>
    </div>
    <div class="photo-main">
      <img src="/images/family.jpg" alt="Mark Gores with his family at home in Prior Lake">
    </div>
  </div>
  <div class="built-grid">
    <div class="ple-card">
      <h3>Prior Lake Events</h3>
      <p>A community calendar and weekly newsletter for Prior Lake. Fish fries, live music, farmers markets, kids events. If it's happening here, it's on PLE.</p>
      <a href="https://priorlakeevents.com" class="ple-link" target="_blank" rel="noopener">Visit PriorLakeEvents.com →</a>
    </div>
    <div class="ple-card">
      <h3>Prior Lake Market Data</h3>
      <p>Real MLS data for Prior Lake, updated daily. What's selling, what's sitting, neighborhood breakdowns, waterfront premiums. A way to look at the market without being sold anything.</p>
      <a href="https://priorlake.realestate" class="ple-link" target="_blank" rel="noopener">Visit PriorLake.RealEstate →</a>
    </div>
    <div class="ple-card">
      <h3>Who to Call</h3>
      <p>The vendor list I send my clients to. Plumbers, roofers, movers, inspectors, 479 providers my team has built up over years of referrals. Describe the problem in plain English and it points you at the right people.</p>
      <a href="/vendors" class="ple-link">See who to call →</a>
    </div>
  </div>
</section>

<!-- Contact -->
<section class="contact" id="contact">
  <div class="section-label" style="justify-content: center;">Get in Touch</div>
  <h2>Start with a question.</h2>
  <p>
    If you're thinking about buying or selling in the Prior Lake area, reach out whenever you're ready. I don't do hard sells. I answer questions.
  </p>

  <form class="contact-form" id="contact-form" novalidate>
    <div class="form-row">
      <label class="form-field">
        <span>Your name <span class="required">*</span></span>
        <input name="name" type="text" required autocomplete="name" />
      </label>
      <label class="form-field">
        <span>Email <span class="required">*</span></span>
        <input name="email" type="email" required autocomplete="email" />
      </label>
    </div>
    <label class="form-field">
      <span>Phone (optional)</span>
      <input name="phone" type="tel" autocomplete="tel" />
    </label>
    <label class="form-field">
      <span>What's going on? <span class="required">*</span></span>
      <textarea name="message" required rows="5"></textarea>
    </label>

    <div class="honeypot" aria-hidden="true">
      <label>
        Company
        <input name="company" type="text" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <div class="form-error" id="contact-error" hidden></div>

    <button type="submit" class="form-submit" id="contact-submit">
      <span class="submit-label">Send</span>
      <span class="submit-loading" hidden>Sending…</span>
    </button>
  </form>

  <div class="contact-success" id="contact-success" hidden>
    <div class="section-label">Got it</div>
    <h3>Thanks. I'll be in touch within a day.</h3>
    <p>If it's urgent, call or text me at <a href="tel:+16122015447">612-201-5447</a>.</p>
  </div>

  <div class="contact-methods">
    <div class="contact-method">
      <span class="label">Call or Text</span>
      <a href="tel:+16122015447">612-201-5447</a>
    </div>
    <div class="contact-method">
      <span class="label">Email</span>
      <a href="mailto:mark@markgores.com">mark@markgores.com</a>
    </div>
  </div>
  <p class="contact-newsletter">Not ready to talk? I send a weekly email about what's happening in Prior Lake. Events, live music, community stuff. No real estate. <a href="https://priorlakeevents.com/newsletter" target="_blank" rel="noopener">Join 850+ subscribers →</a></p>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('contact-error') as HTMLDivElement | null;
  const successEl = document.getElementById('contact-success') as HTMLDivElement | null;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;

  if (form && errorEl && successEl && submitBtn) {
    const submitLabel = submitBtn.querySelector('.submit-label') as HTMLElement;
    const submitLoading = submitBtn.querySelector('.submit-loading') as HTMLElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitBtn.disabled) return;

      submitBtn.disabled = true;
      submitLabel.hidden = true;
      submitLoading.hidden = false;
      errorEl.hidden = true;
      errorEl.textContent = '';

      const data = new FormData(form);
      const payload = {
        name: String(data.get('name') ?? '').trim(),
        email: String(data.get('email') ?? '').trim(),
        phone: String(data.get('phone') ?? '').trim(),
        message: String(data.get('message') ?? '').trim(),
        company: String(data.get('company') ?? ''),
      };

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) {
          const body = await res.json().catch(() => ({}));
          throw new Error(body.error || 'Something went wrong.');
        }
        form.hidden = true;
        successEl.hidden = false;
        form.reset();
        successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (err) {
        errorEl.textContent = err instanceof Error ? err.message : 'Something went wrong.';
        errorEl.hidden = false;
      } finally {
        submitBtn.disabled = false;
        submitLabel.hidden = false;
        submitLoading.hidden = true;
      }
    });
  }
</script>

</main>

<!-- Footer -->
<footer>
  <p>&copy; 2026 Mark Gores · RE/MAX Advantage Plus</p>
  <p class="tagline">Real estate without the pitch.</p>
</footer>

</BaseLayout>
