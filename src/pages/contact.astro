---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Contact Mark Gores | Realtor in Prior Lake, MN";
const description = "Call, text, or email Mark Gores directly. No forms, no funnels, no drip campaigns. Usually responds within an hour. 612-201-5447.";
---

<BaseLayout title={title} description={description}>
  <Header />

  <main>
    <h1 class="page-title">Get in Touch</h1>

    <p class="intro reveal">
      Want to talk about buying or selling? Have a quick question about the market? Just reach out. I respond quickly—usually within an hour during normal hours. Evenings and weekends too.
    </p>

    <p class="intro-note reveal" data-delay="50">
      Text is fastest, but I pick up the phone too.
    </p>

    <div class="contact-methods">
      <a href="tel:+16122015447" class="contact-method reveal" data-delay="100">
        <span class="contact-icon">📱</span>
        <div class="contact-info">
          <span class="contact-label">Call or text</span>
          <span class="contact-value">612-201-5447</span>
        </div>
      </a>

      <a href="mailto:mark@markgores.com" class="contact-method reveal" data-delay="200">
        <span class="contact-icon">✉️</span>
        <div class="contact-info">
          <span class="contact-label">Email</span>
          <span class="contact-value">mark@markgores.com</span>
        </div>
      </a>
    </div>

    <div class="note-box reveal" data-delay="300">
      <p>
        <strong>No contact form on purpose.</strong> I'm not going to add you to a database or put you on a drip campaign. Just call, text, or email. I'll get back to you—personally, not an assistant.
      </p>
    </div>

    <div class="soft-cta reveal" data-delay="350">
      <p>
        Even if you're just starting to think about buying or selling and don't have anything specific yet—that's fine. I'm happy to talk through it. No commitment, no pitch.
      </p>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-md);
  }

  .intro {
    font-size: var(--text-lg);
    margin-bottom: var(--space-sm);
  }

  .intro-note {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    font-style: italic;
    margin-bottom: var(--space-xl);
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .contact-method {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-lg);
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s var(--ease-out-expo);
  }

  .contact-method:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .contact-icon {
    font-size: var(--text-2xl);
    transition: transform 0.3s var(--ease-out-expo);
  }

  .contact-method:hover .contact-icon {
    transform: scale(1.1);
  }

  .contact-info {
    display: flex;
    flex-direction: column;
  }

  .contact-label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .contact-value {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text);
  }

  .note-box {
    background-color: var(--color-highlight);
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-lg);
  }

  .note-box p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .note-box strong {
    color: var(--color-text);
  }

  .soft-cta {
    padding: var(--space-md) 0;
  }

  .soft-cta p {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    margin: 0;
  }
</style>
