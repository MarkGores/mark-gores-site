---
// Shared footer for the public pages (see SiteHeader for the body.site contract).
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap cols">
    <div class="who">
      <p class="who-name">Mark Gores, REALTOR&reg;</p>
      <p>RE/MAX Advantage Plus<br />13875 Highway 13 South, Savage, MN 55378</p>
      <p><a href="tel:+16122015447">612-201-5447</a> &middot; <a href="mailto:mark@markgores.com">mark@markgores.com</a></p>
    </div>
    <nav aria-label="Footer">
      <ul>
        <li><a href="/#selling">Selling</a></li>
        <li><a href="/#buying">Buying</a></li>
        <li><a href="/vendors">Who to call</a></li>
        <li><a href="/savage">Savage</a></li>
        <li><a href="/prior-lake-realtor">Picking a realtor</a></li>
      </ul>
      <ul>
        <li><a href="https://www.priorlake.realestate" rel="noopener">priorlake.realestate</a></li>
        <li><a href="https://priorlakeevents.com" rel="noopener">Prior Lake Events</a></li>
        <li><a href="https://www.zillow.com/profile/MarkGoresREMAX" rel="noopener">Reviews on Zillow</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap fine">
    <p>&copy; {year} Mark Gores. Each RE/MAX office is independently owned and operated.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 0;
    padding: 3.5rem 0 2.5rem;
    border-top: 1px solid var(--rule);
    font-size: 0.98rem;
    color: var(--ink-3);
  }
  .cols {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2.5rem 4rem;
  }
  .who p + p { margin-top: 0.6rem; }
  .who-name {
    font-family: var(--serif);
    font-size: 1.3rem;
    color: var(--ink);
  }
  nav {
    display: flex;
    gap: 3.5rem;
  }
  ul { list-style: none; }
  li + li { margin-top: 0.4rem; }
  a {
    color: var(--ink-2);
    text-decoration: none;
  }
  a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .fine {
    margin-top: 2.5rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }
  @media (max-width: 560px) {
    nav { gap: 2rem; }
  }
</style>
